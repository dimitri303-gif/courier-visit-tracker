{
  "expo": {
    "name": "Courier Tracker",
    "slug": "courier-visit-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Додаток використовує геолокацію для відстеження прибуття кур'єра на торгові точки під час активної зміни.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Додатку потрібен постійний доступ до геолокації для фонового відстеження візитів під час робочої зміни."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.jpg",
        "backgroundColor": "#0f172a"
      },
      "package": "com.couriermvp.tracker",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "e244d165-30f6-4f18-9989-d7b5551706f5"
      }
    }
  }
}
